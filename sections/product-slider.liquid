{{ 'section-product-slider.css' | asset_url | stylesheet_tag }}
<script src="{{ 'section-product-slider.js' | asset_url }}" defer></script>

{{ 'component-product-card.css' | asset_url | stylesheet_tag }}
<script src="{{ 'component-product-card.js' | asset_url }}" defer></script>

{% style %}
  #shopify-section-{{ section.id }} .s-product-slider {
    margin-top: {{ section.settings.margin_top_m }}px;
    margin-bottom: {{ section.settings.margin_bottom_m }}px;
    padding-top: {{ section.settings.padding_top_m }}px;
    padding-bottom: {{ section.settings.padding_bottom_m }}px;
    background-color: {{ section.settings.bg_color }};
  }

  #shopify-section-{{ section.id }} .s-product-slider__container {
    {% if section.settings.enable_container %}
      max-width: {{ section.settings.container_width }}px;
    {% endif %}
  }


  #shopify-section-{{ section.id }} .s-product-slider__heading {
    padding-bottom: {{ section.settings.heading_bottom_padding_m }}px;
  }

  #shopify-section-{{ section.id }} .s-product-slider__title {
    font-size: {{ section.settings.title_font_size_m }}px;
    font-weight: {{ section.settings.title_font_weight_m }};
    color: {{ section.settings.title_color_m }};
    font-family: {{ section.settings.title_font_family_m }};
    text-align: {{ section.settings.title_align_m }};
    {% if section.settings.title_is_italic_m %}
      font-style: italic;
    {% endif %}

    {% if section.settings.title_is_underline_m %}
      text-decoration: underline;
    {% endif %}

    {% if section.settings.title_is_uppercase_m %}
      text-transform: uppercase;
    {% endif %}
  }

  #shopify-section-{{ section.id }} .s-product-slider__subtitle {
    font-size: {{ section.settings.subtitle_font_size_m }}px;
    font-weight: {{ section.settings.subtitle_font_weight_m }};
    color: {{ section.settings.subtitle_color_m }};
    font-family: {{ section.settings.subtitle_font_family_m }};
    text-align: {{ section.settings.subtitle_align_m }};
    {% if section.settings.subtitle_is_italic_m %}
      font-style: italic;
    {% endif %}

    {% if section.settings.subtitle_is_underline_m %}
      text-decoration: underline;
    {% endif %}

    {% if section.settings.subtitle_is_uppercase_m %}
      text-transform: uppercase;
    {% endif %}
  }

  @media screen and (min-width: 768px) {
    #shopify-section-{{ section.id }} .s-product-slider {
      margin-top: {{ section.settings.margin_top_d }}px;
      margin-bottom: {{ section.settings.margin_bottom_d }}px;
      padding-top: {{ section.settings.padding_top_d }}px;
      padding-bottom: {{ section.settings.padding_bottom_d }}px;
    }


    #shopify-section-{{ section.id }} .s-product-slider__heading {
      padding-bottom: {{ section.settings.heading_bottom_padding_d }}px;
    }

    #shopify-section-{{ section.id }} .s-product-slider__title {
      font-size: {{ section.settings.title_font_size_d }}px;
      font-weight: {{ section.settings.title_font_weight_d }};
      color: {{ section.settings.title_color_d }};
      font-family: {{ section.settings.title_font_family_d }};
      text-align: {{ section.settings.title_align_d }};
      {% if section.settings.title_is_italic_d %}
        font-style: italic;
      {% endif %}

      {% if section.settings.title_is_underline_d %}
        text-decoration: underline;
      {% endif %}

      {% if section.settings.title_is_uppercase_d %}
        text-transform: uppercase;
      {% endif %}
    }

    #shopify-section-{{ section.id }} .s-product-slider__subtitle {
      font-size: {{ section.settings.subtitle_font_size_d }}px;
      font-weight: {{ section.settings.subtitle_font_weight_d }};
      color: {{ section.settings.subtitle_color_d }};
      font-family: {{ section.settings.subtitle_font_family_d }};
      text-align: {{ section.settings.subtitle_align_d }};
      {% if section.settings.subtitle_is_italic_d %}
        font-style: italic;
      {% endif %}

      {% if section.settings.subtitle_is_underline_d %}
        text-decoration: underline;
      {% endif %}

      {% if section.settings.subtitle_is_uppercase_d %}
        text-transform: uppercase;
      {% endif %}
    }
  }
{% endstyle %}

{% liquid
  assign title_d = section.settings.title_d
  assign title_m = section.settings.title_m | default: title_d

  assign subtitle_d = section.settings.subtitle_d
  assign subtitle_m = section.settings.subtitle_m | default: subtitle_d

  assign products = blank

  case section.settings.products_source
    when 'collection'
      assign products = section.settings.collection.products
    when 'products_list'
      assign products = section.settings.product_list
    when 'recommendations'
      assign products = product.metafields.custom.recommended_products.value | default: recommendations.products
  endcase
%}

{% if products != blank or product != blank %}
  <s-product-slider
    data-products-source="{{ section.settings.products_source }}"
    data-product-id="{{ product.id }}"
    data-products-limit="{{ section.settings.products_limit }}"
    data-section-id="{{ section.id }}"
    data-recommendations-type="{{ section.settings.recommendations_type }}"
    class="s-product-slider"
  >
    <div class="s-product-slider__container">
      <div class="s-product-slider__heading">
        {% if title_d != blank %}
          <h2 class="s-product-slider__title s-product-slider__title--desktop">{{ title_d }}</h2>
        {% endif %}
        {% if title_m != blank %}
          <h2 class="s-product-slider__title s-product-slider__title--mobile">{{ title_m }}</h2>
        {% endif %}
        {% if subtitle_d != blank %}
          <div class="s-product-slider__subtitle s-product-slider__subtitle--desktop">{{ subtitle_d }}</div>
        {% endif %}
        {% if subtitle_m != blank %}
          <div class="s-product-slider__subtitle s-product-slider__subtitle--mobile">{{ subtitle_m }}</div>
        {% endif %}
      </div>
      <div class="s-product-slider__grid js-product-slider__grid">
        <swiper-container
          style="
            --pagination-padding-top: {{ section.settings.slider_pagination_padding_top_d }}px;
            --bullets_color: {{ section.settings.slider_bullets_color_d }};
            --bullets_border_color: {{ section.settings.slider_bullets_border_color_d }};
            --bullets_active_color: {{ section.settings.slider_bullets_active_color_d }};
            --fraction_color: {{ section.settings.slider_fraction_color_d }};
          "
          class="s-product-slider__slider s-product-slider__slider--desktop js-product-slider__slider"
          space-between="{{ section.settings.space_between_d }}"
          slides-per-view="{{ section.settings.slides_per_view_d }}"
          {% if section.settings.enable_slider_loop_d %}
            loop="true"
          {% endif %}
          {% if section.settings.enable_slider_autoplay_d %}
            autoplay="true"
            autoplay-delay="{{ section.settings.slider_autoplay_delay_d }}"
          {% endif %}
          {% if section.settings.enable_slider_pagination_d %}
            pagination="true"
            pagination-type="{{ section.settings.slider_pagination_type_d }}"
            pagination-clickable="{{ section.settings.slider_enable_pagination_clickable_d }}"
          {% endif %}
          speed="{{ section.settings.slider_change_speed_d }}"
        >
          {% for product in products limit: section.settings.products_limit %}
            <swiper-slide class="s-product-slider__slide">
              {% render 'product-card',
                product: product,
                media_type: 'image',
                display_wishlist: section.settings.card_display_wishlist_d,
                display_sold_out_badge: section.settings.card_display_sold_out_badge_d,
                display_tag_badge: section.settings.card_display_tag_badge_d,
                display_discount_badge: section.settings.card_display_discount_badge_d,
                display_low_stock_badge: section.settings.card_display_low_stock_badge_d,
                display_simple_color_swatch: section.settings.card_display_simple_color_swatch_d,
                display_add_to_cart: section.settings.card_display_add_to_cart_d,
                display_product_type: section.settings.card_display_product_type_d
              %}
            </swiper-slide>
          {% endfor %}
        </swiper-container>

        <swiper-container
          style="
            --pagination-padding-top: {{ section.settings.slider_pagination_padding_top_m }}px;
            --bullets_color: {{ section.settings.slider_bullets_color_m }};
            --bullets_border_color: {{ section.settings.slider_bullets_border_color_m }};
            --bullets_active_color: {{ section.settings.slider_bullets_active_color_m }};
            --fraction_color: {{ section.settings.slider_fraction_color_m }};
          "
          class="s-product-slider__slider s-product-slider__slider--mobile js-product-slider__slider"
          space-between="{{ section.settings.space_between_m }}"
          slides-per-view="{{ section.settings.slides_per_view_m }}"
          {% if section.settings.enable_slider_loop_m %}
            loop="true"
          {% endif %}
          {% if section.settings.enable_slider_autoplay_m %}
            autoplay="true"
            autoplay-delay="{{ section.settings.slider_autoplay_delay_m }}"
          {% endif %}
          {% if section.settings.enable_slider_pagination_m %}
            pagination="true"
            pagination-type="{{ section.settings.slider_pagination_type_m }}"
            pagination-clickable="{{ section.settings.slider_enable_pagination_clickable_m }}"
          {% endif %}
          speed="{{ section.settings.slider_change_speed_m }}"
        >
          {% for product in products limit: section.settings.products_limit %}
            <swiper-slide class="s-product-slider__slide">
              {% render 'product-card',
                product: product,
                media_type: 'image',
                display_wishlist: section.settings.card_display_wishlist_m,
                display_sold_out_badge: section.settings.card_display_sold_out_badge_m,
                display_tag_badge: section.settings.card_display_tag_badge_m,
                display_discount_badge: section.settings.card_display_discount_badge_m,
                display_low_stock_badge: section.settings.card_display_low_stock_badge_m,
                display_simple_color_swatch: section.settings.card_display_simple_color_swatch_m,
                display_add_to_cart: section.settings.card_display_add_to_cart_m,
                display_product_type: section.settings.card_display_product_type_m
              %}
            </swiper-slide>
          {% endfor %}
        </swiper-container>
      </div>
    </div>
  </s-product-slider>
{% endif %}

{% schema %}
{
  "name": "Product slider",
  "settings": [
    {
      "type": "header",
      "content": "Metafields"
    },
    {
      "type": "paragraph",
      "content": "Metafield custom.recommended_products is used for recommended products. If it is empty - the shopify recommendation products are shown"
    },
    {
      "type": "header",
      "content": "Container settings"
    },
    {
      "type": "color",
      "label": "Background color",
      "id": "bg_color",
      "default": "#fff"
    },
    {
      "type": "checkbox",
      "id": "enable_container",
      "label": "Enable container",
      "default": true
    },
    {
      "type": "range",
      "max": 2000,
      "min": 1000,
      "step": 10,
      "id": "container_width",
      "default": 1440,
      "unit": "px",
      "label": "Container width",
      "info": "Recommended max-width: 1440px",
      "visible_if": "{{ section.settings.enable_container }}"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "select",
      "id": "products_source",
      "label": "Products source",
      "options": [
        {
          "label": "Collection",
          "value": "collection"
        },
        {
          "label": "Products list",
          "value": "products_list"
        },
        {
          "label": "Recommendations (Works only on PDP)",
          "value": "recommendations"
        }
      ],
      "default": "collection",
      "info": "Metafield custom.recommended_products is used for recommended products."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "If Products source value is equal to collection"
    },
    {
      "type": "product_list",
      "limit": 50,
      "id": "product_list",
      "label": "Product list",
      "info": "If Products source value is equal to products list"
    },
    {
      "type": "select",
      "id": "recommendations_type",
      "label": "Recommendations type",
      "options": [
        {
          "label": "Related",
          "value": "related"
        },
        {
          "label": "Complementary",
          "value": "complementary"
        }
      ],
      "default": "related",
      "visible_if": "{{ section.settings.products_source == 'recommendations' }}"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 0,
      "max": 50,
      "step": 1,
      "label": "Products limit",
      "default": 16
    },
    {
      "type": "header",
      "content": "Slider settings (Desktop)"
    },
    {
      "type": "range",
      "max": 8,
      "min": 1,
      "step": 1,
      "default": 4,
      "label": "Slides per view",
      "id": "slides_per_view_d"
    },
    {
      "type": "range",
      "id": "space_between_d",
      "max": 100,
      "min": 0,
      "step": 1,
      "unit": "px",
      "default": 0,
      "label": "Space between"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_loop_d",
      "label": "Enable loop",
      "default": false
    },
    {
      "type": "range",
      "id": "slider_change_speed_d",
      "min": 100,
      "max": 5000,
      "step": 100,
      "unit": "ms",
      "label": "Slider change speed",
      "default": 500
    },
    {
      "type": "checkbox",
      "id": "enable_slider_autoplay_d",
      "label": "Enable autoplay",
      "default": false
    },
    {
      "type": "range",
      "id": "slider_autoplay_delay_d",
      "min": 100,
      "max": 5000,
      "step": 100,
      "unit": "ms",
      "label": "Autoplay delay",
      "default": 500,
      "visible_if": "{{ section.settings.enable_slider_autoplay_d }}"
    },
    {
      "type": "checkbox",
      "id": "enable_slider_pagination_d",
      "label": "Enable pagination",
      "default": true
    },
    {
      "type": "select",
      "id": "slider_pagination_type_d",
      "label": "Pagination type",
      "options": [
        {
          "label": "Bullets",
          "value": "bullets"
        },
        {
          "label": "Fraction",
          "value": "fraction"
        },
      ],
      "default": "bullets",
      "visible_if": "{{ section.settings.enable_slider_pagination_d }}"
    },
    {
      "type": "color",
